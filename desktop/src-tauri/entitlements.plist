<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Applied by Tauri when ad-hoc signing the app. disable-library-validation lets the
  bundled DeutschX engine (PyInstaller) load its embedded libpython, which carries
  Python's own Team ID. Without it macOS blocks it with "different Team IDs".
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
</dict>
</plist>
