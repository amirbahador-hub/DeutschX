# DeutschX is configured in-app — you normally DON'T need this file.
# Open the app and paste your Anthropic API key on the welcome screen (or in Settings).
# Get a key at https://console.anthropic.com/settings/keys
#
# This file is only for developers who prefer environment variables. Copy it to .env:
# ANTHROPIC_API_KEY=sk-ant-...
#
# Optional overrides:
# DEUTSCHX_MODEL=claude-sonnet-4-6
# DEUTSCHX_DATA_DIR=./data            # where lessons/settings are stored (dev convenience)
